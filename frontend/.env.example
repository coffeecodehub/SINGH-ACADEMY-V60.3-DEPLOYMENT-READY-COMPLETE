# Local development: call the backend directly.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Split production hosting (for example Vercel frontend + Render backend):
# set NEXT_PUBLIC_API_URL=/api and API_PROXY_TARGET=https://your-backend.example.com
# so browser sessions/cookies remain same-origin while Next.js proxies /api server-side.
API_PROXY_TARGET=
